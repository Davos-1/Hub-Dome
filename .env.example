NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # nur serverseitig
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TOKEN_PEPPER=                     # zusätzlicher Geheimwert für Token-Hashes
GITHUB_TOKEN=                     # optional, erhöht das GitHub-API-Limit für Vorschauen
CRON_SECRET=                      # nur auf Vercel: schützt /api/cron/* (Vercel sendet ihn als Bearer-Token)
NEXT_PUBLIC_GOOGLE_LOGIN=         # true, sobald der Google-Login in Supabase eingerichtet ist
